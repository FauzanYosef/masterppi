# Salin ke .env.local (development) atau .env (server, untuk docker-compose.prod.yml).

# URL fisip-api yang diakses browser — tanpa akhiran /api
NEXT_PUBLIC_API_URL=https://api-fisip.uinsgd.ac.id
# Domain website; dikirim sebagai header X-Site-Domain untuk menentukan data prodi (Magister PPI = prodi id 3)
NEXT_PUBLIC_SITE_DOMAIN=magisterppi.uinsgd.ac.id
# URL publik website (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://magisterppi.uinsgd.ac.id

# URL API yang diakses server Next.js (opsional; default = NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=https://api-fisip.uinsgd.ac.id
# Lama cache data API di server (detik) untuk metadata & sitemap
API_REVALIDATE_SECONDS=300
# true = gambar dimuat langsung oleh browser tanpa optimizer Next.js (Docker lokal)
NEXT_IMAGE_UNOPTIMIZED=false
# Port host untuk docker-compose.prod.yml
WEB_PORT=3002
